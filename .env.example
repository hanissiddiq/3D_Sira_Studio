NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. JANGAN diberi prefix NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# URL publik situs (dipakai sebagai callback_url DOKU). Produksi: gunakan https.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- DOKU Checkout (DOKU Dashboard > Integration > API Keys) ---
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=

# sandbox | production
DOKU_ENV=sandbox
# Metode pada halaman pembayaran, dipisah koma. Satu metode = pelanggan langsung diarahkan ke metode itu.
# Kosongkan untuk menampilkan semua metode yang aktif di akun DOKU. Nilai: lihat "Supported Payment Methods" DOKU.

DOKU_PAYMENT_METHODS=QRIS
# popup (default): jendela DOKU tampil di atas situs | redirect: pindah ke halaman DOKU
DOKU_CHECKOUT_MODE=popup
# Batas waktu bayar (menit, 10-1440). Pesanan yang lewat batas dibatalkan oleh job /api/cron/expire-orders.
DOKU_PAYMENT_DUE_MINUTES=60
# Token untuk memanggil /api/cron/expire-orders (header: Authorization: Bearer <token>)
CRON_SECRET=

# Opsional
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_STUDIO_ADDRESS=
SHIPPING_ORIGIN_PROVINCE=Aceh
